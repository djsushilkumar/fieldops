# FieldOps Environment Configuration Template
# Copy this file to .env and fill in the values for your deployment.
# NEVER commit .env or any file containing real secrets to version control.

# Supabase Client Configuration (Safe for client build)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Supabase Database Administration (Used only by backend/CI migration scripts)
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
